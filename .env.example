# Hector Mathabe personal / marketing site (booking face)
# Until custom domain is live, point at the Vercel preview/production app.
NEXT_PUBLIC_MATHABE_SITE_URL=https://hector-motivator.vercel.app

# Team-building brochure journey (/team-building). Server-side only: never prefix with NEXT_PUBLIC_.
# Answers are emailed to TMC's own mailbox via its Xneelo SMTP; the brochure download unlocks only after success.
SMTP_HOST=mail.themotivationcompany.co.za
# 465 = SSL/TLS (default). Use 587 for STARTTLS. SMTP_SECURE overrides the port-based default.
SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=bookings@themotivationcompany.co.za
SMTP_PASS=
# From = the mailbox itself so SPF (mx a include:spf.host-h.net) stays aligned. Reply-to is the visitor.
MAIL_FROM=bookings@themotivationcompany.co.za
BOOKINGS_INBOX=bookings@themotivationcompany.co.za
# HMAC secret for 24h brochure download links (random, 32+ chars, e.g. `openssl rand -base64 48`).
DOWNLOAD_SECRET=
# Production guard: page + routes only work on production when this is "true"
# AND private/brochure/manifest.json has "placeholder": false.
BROCHURE_READY=false
# Dev/test only (ignored on Vercel production):
# MAIL_DRIVER=file           # write emails to MAIL_OUTBOX_DIR instead of SMTP
# MAIL_OUTBOX_DIR=.mail-outbox
# MAIL_FORCE_FAIL=true       # force the send to fail to test the error message
# SMTP_NO_AUTH=true          # local SMTP sink without auth/TLS
